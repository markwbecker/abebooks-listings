# Copy to .env and fill in. .env is gitignored — never commit real values.
# This repo is PUBLIC.

# Vendor client PIN (sent as <username>)
ABEBOOKS_CLIENT_PIN=

# API key (sent as <password> under legacy PIN/API-key auth)
ABEBOOKS_API_KEY=

# HMAC-SHA256 shared secret, if using signed-request auth instead of PIN/API key.
# See https://www.abebooks.com/developer/authentication/signing-requests
ABEBOOKS_HMAC_SECRET=

# Endpoint — note the non-standard port.
ABEBOOKS_ENDPOINT=https://inventoryupdate.abebooks.com:10027/
